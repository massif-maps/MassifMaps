{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "styleref",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8099",
        "--directory",
        "tools/style-cli/wasm"
      ],
      "port": 8099
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "web/demo/serve.py",
        "--port",
        "8088"
      ],
      "port": 8088
    },
    {
      "name": "style-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/style-preview/serve.py",
        "--port",
        "8787",
        "--mbtiles",
        "rhone-alpes=/Volumes/dev/carto/alpimaps_data_generator/alpimaps_mbtiles/rhone-alpes/rhone-alpes.mbtiles"
      ],
      "port": 8787
    },
    {
      "name": "mbref",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8231",
        "--directory",
        "/tmp/mbref"
      ],
      "port": 8231
    }
  ]
}
