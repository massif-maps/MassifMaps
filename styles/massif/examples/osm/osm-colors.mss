/* OpenStreetMap Carto's colours, as Alpimaps' OSM style has them, over Massif's palette. Listed
   BEFORE variables.mss: the compiler keeps the first declaration of a variable. The widths are
   Massif's; only the colours change. */
@land: #f2efe9;
@background_2: #f2efe9;
@motorway: #e892a2;
@motorway_case: #dc2a67;
@trunk: #f9b29c;
@trunk_case: #c84e2f;
@primary: #fcd6a4;
@secondary: #f7fabf;
@road: #ffffff;
@road_low: #ffffff;
@road_case: #b3b7cb;
@water: #aad3df;
@wood: #add19e;
@wood_low: #add19e;
@grass: #cdebb0;
@park: #c8facc;
@farmland: #eef0d5;
@residential: #e0dfdf;
@commercial: #f2dad9;
@industrial: #ebdbe8;
@cemetery: #aacbaf;
@sand: #f5e9c6;
@rock: #eee5dc;
@glacier: #ddecec;
@building_fill: #d9d0c9;
@building_stroke: #c4b6ab;
@track: #996600;
