{
  "version": 8,
  "name": "mapbox2css test fixture",
  "sources": { "osm": { "type": "vector", "url": "mbtiles://osm" } },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f0f0f0" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": { "fill-color": "#c8e0b0", "fill-opacity": 0.6, "fill-antialias": true }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 6,
      "maxzoom": 20,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "motorway"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#802000",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 16, 12],
        "line-blur": 2
      }
    },
    {
      "id": "road-fill",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "paint": {
        "line-color": ["match", ["get", "class"], "motorway", "#ff8000", ["trunk", "primary"], "#ffc000", "#ffffff"],
        "line-width": ["step", ["zoom"], 1, 10, 2, 14, 6],
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.5, 1]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "symbol-placement": "line"
      },
      "paint": { "text-color": "#333333", "text-halo-color": "#ffffff", "text-halo-width": 1 }
    },
    {
      "id": "buildings",
      "type": "fill-extrusion",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#cccccc",
        "fill-extrusion-height": ["get", "render_height"],
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "heat",
      "type": "heatmap",
      "source": "osm",
      "source-layer": "poi",
      "paint": { "heatmap-radius": 30 }
    }
  ]
}
